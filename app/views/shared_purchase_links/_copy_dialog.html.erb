<%= turbo_frame_tag :modal do %>
  <dialog id="share-purchased-link-modal" class="modal" open>
    <div class="modal-box" open data-controller="share-purchased-link-modal">
      <form method="dialog" class="absolute right-2 top-2">
        <button aria-label="Close" class="btn btn-sm btn-circle btn-ghost" data-action="click->share-purchased-link-modal#close">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </form>
      <h3 class="text-lg font-bold">Share purchase link</h3>
      <div class="mt-4 flex items-center gap-2">
        <input id="share-link" type="text" class="input input-bordered w-full" data-share-purchased-link-modal-target="sharedLink" readonly value=<%= uri %> />
        <button id="copy-link-btn" type="button" aria-label="Copy link" class="btn btn-primary btn-circle" data-action="click->share-purchased-link-modal#copy">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5">
            <rect x="9" y="9" width="10" height="12" rx="2" ry="2" stroke-width="2"/>
            <path d="M7 15H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v1" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
    </div>
  </dialog>
<%end%>