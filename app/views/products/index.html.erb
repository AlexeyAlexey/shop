<% content_for :title, "Products" %>
<% if @products.any? && Current.shared_purchase_link_id.present? %>
  <turbo-frame id="shared-purchases-aside" src="<%= shared_purchases_path %>">
    Loading...
  </turbo-frame>
<%end%>
<div id="products" class="grid grid-cols-1 gap-4 p-4 sm:grid-cols-2 lg:grid-cols-3">
  <% if @products.any? %>
    <% @products.each do |product| %>
      <%= render "product_card", product: product, show_shared_button: Current.shared_purchase_link_id.present? %>
    <% end %>
  <% else %>
    <p class="text-center my-10">No products found.</p>
  <% end %>
</div>
<% if Current.shared_purchase_link_id.present? %>
  <%= turbo_stream_from Current.shared_purchase_link_id, :shared_purchases %>
<%end%>
