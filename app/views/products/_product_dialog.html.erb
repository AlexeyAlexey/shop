<%= turbo_frame_tag :modal do %>
  <dialog id="shares-purchase-product-dialog" class="modal" open>
    <div class="modal-box w-full max-w-5xl h-[90vh] overflow-y-auto p-0">
      <header class="flex justify-end sticky top-0 z-10 bg-base-100/90 backdrop-blur px-6 py-2">
        <% if Current.shared_purchase_link_id.present? %>
          <%= render 'share_button', product: product, 
                                   button_class: "btn btn-sm btn-circle btn-ghost", 
                                   button_form_class: "mr-auto" %>
        <% end %>
        <form method="dialog">
          <button class="btn btn-sm btn-circle btn-ghost" aria-label="Close">✕</button>
        </form>
      </header>
      <div class="px-6 pb-6 pt-4">
        <%= render "product_slide", imgs: product.slide_imgs %>
      </div>
      <div class="mt-6">
        <%= render "product_details" %>
      </div>
    </div>
  </dialog>
<%end%>