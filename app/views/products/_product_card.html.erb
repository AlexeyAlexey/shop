<div id="<%= dom_id product %>" class="card relative bg-base-100 shadow-sm transition-shadow hover:shadow-md">
  <%if show_shared_button %>
    <%= render 'share_button', product: product, 
                               button_class: "btn btn-circle btn-ghost btn-sm absolute left-2 top-2 z-10" %>
  <%end%>
  <figure>
    <%= image_tag(product.preview_img, alt: 'Shoes') %>
  </figure>
  <div class="flex flex-col items-center justify-center gap-4">
    <div class="rating">
      <input type="radio" name="rating-1" class="mask mask-star" />
      <input type="radio" name="rating-1" class="mask mask-star" checked />
      <input type="radio" name="rating-1" class="mask mask-star" />
      <input type="radio" name="rating-1" class="mask mask-star" />
      <input type="radio" name="rating-1" class="mask mask-star" />
    </div>
  </div>
  <div class="card-body flex flex-col justify-center gap-4">
    <h2 class="card-title"><%= product.title %></h2>
    <p> <%= product.description %></p>
    <div class="card-actions justify-end">
      <%= button_to "View", product_path(id: product.id), method: :get, data: { turbo_frame: :modal }, class: "btn btn-primary"  %>
    </div>
  </div>
</div>
